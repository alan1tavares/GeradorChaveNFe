<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GeradorChaveNFe.MainPage">

    <Grid ColumnDefinitions="380,*" RowDefinitions="*" ColumnSpacing="0">

        <!-- Painel esquerdo: formulário -->
        <Grid Grid.Column="0" RowDefinitions="*" BackgroundColor="#6B5B4E">
            <VerticalStackLayout Spacing="12" Padding="20" VerticalOptions="Start">

                <!-- Tarefa 2: título do painel -->
                <Label Text="Configurações do Gerador"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="White"
                       Margin="0,0,0,8" />

                <Label Text="UF:" TextColor="White" />
                <Border BackgroundColor="White"
                        Stroke="Transparent"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8"
                        Padding="4,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <Image Grid.Column="0"
                               Source="brazil_ico.png"
                               HeightRequest="22"
                               WidthRequest="22"
                               VerticalOptions="Center"
                               Margin="6,0,4,0" />
                        <Picker Grid.Column="1"
                                x:Name="uFPicker"
                                Title="Selecione o estado (ex: SP)"
                                ItemDisplayBinding="{Binding Nome}"
                                BackgroundColor="Transparent"
                                TextColor="#333333"
                                TitleColor="#888888" />
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,Auto" RowSpacing="4">

                    <Label Grid.Column="0" Grid.Row="0" Text="Data (Mês/Ano)" TextColor="White" />
                    <Label Grid.Column="2" Grid.Row="0" Text="Ano:" TextColor="White" />

                    <!-- Campo Mês -->
                    <Border Grid.Column="0" Grid.Row="1"
                            BackgroundColor="White"
                            Stroke="Transparent"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8"
                            Padding="4,0">
                        <Grid ColumnDefinitions="Auto,*">
                            <Label Grid.Column="0" Text="📅" FontSize="15"
                                   VerticalOptions="Center" Margin="6,0,4,0" />
                            <Entry Grid.Column="1" x:Name="mesEntry"
                                   Keyboard="Numeric"
                                   Placeholder="01-12"
                                   BackgroundColor="Transparent"
                                   TextColor="#333333"
                                   PlaceholderColor="#888888" />
                        </Grid>
                    </Border>

                    <!-- Separador -->
                    <Label Grid.Column="1" Grid.Row="1" Text="/"
                           TextColor="White" FontSize="20"
                           VerticalOptions="Center" Margin="6,0" />

                    <!-- Campo Ano -->
                    <Border Grid.Column="2" Grid.Row="1"
                            BackgroundColor="White"
                            Stroke="Transparent"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8"
                            Padding="4,0">
                        <Grid ColumnDefinitions="Auto,*">
                            <Label Grid.Column="0" Text="🕐" FontSize="15"
                                   VerticalOptions="Center" Margin="6,0,4,0" />
                            <Entry Grid.Column="1" x:Name="anoEntry"
                                   Keyboard="Numeric"
                                   Placeholder="YYYY"
                                   BackgroundColor="Transparent"
                                   TextColor="#333333"
                                   PlaceholderColor="#888888" />
                        </Grid>
                    </Border>

                </Grid>

                <Label Text="Empresa (CNPJ):" TextColor="White" />
                <Border BackgroundColor="White"
                        Stroke="Transparent"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8"
                        Padding="4,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0" Text="🏢" FontSize="15"
                               VerticalOptions="Center" Margin="6,0,4,0" />
                        <Entry Grid.Column="1" x:Name="cnpjEntry"
                               Keyboard="Numeric"
                               Placeholder="00.000.000/0000-00"
                               BackgroundColor="Transparent"
                               TextColor="#333333"
                               PlaceholderColor="#888888"
                               TextChanged="OnCnpjTextChanged" />
                    </Grid>
                </Border>

                <Label Text="Documento (Série):" TextColor="White" />
                <Border BackgroundColor="White"
                        Stroke="Transparent"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8"
                        Padding="4,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0" Text="📄" FontSize="15"
                               VerticalOptions="Center" Margin="6,0,4,0" />
                        <Entry Grid.Column="1" x:Name="serieEntry"
                               Keyboard="Numeric"
                               BackgroundColor="Transparent"
                               TextColor="#333333"
                               PlaceholderColor="#888888" />
                    </Grid>
                </Border>

                <Border Stroke="#8B7B6E" StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="10" Margin="0,4,0,4">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Número da Nota:" TextColor="White" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="*,12,*" ColumnSpacing="0">

                            <!-- Inicial -->
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Inicial:" TextColor="White" />
                                <Border BackgroundColor="White"
                                        Stroke="Transparent"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="4,0">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Label Grid.Column="0" Text="→" FontSize="15"
                                               TextColor="#555555"
                                               VerticalOptions="Center" Margin="6,0,4,0" />
                                        <Entry Grid.Column="1" x:Name="numeroNotaInicialEntry"
                                               Keyboard="Numeric"
                                               BackgroundColor="Transparent"
                                               TextColor="#333333" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Final -->
                            <VerticalStackLayout Grid.Column="2" Spacing="4">
                                <Label Text="Final:" TextColor="White" />
                                <Border BackgroundColor="White"
                                        Stroke="Transparent"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="4,0">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Label Grid.Column="0" Text="→" FontSize="15"
                                               TextColor="#555555"
                                               VerticalOptions="Center" Margin="6,0,4,0" />
                                        <Entry Grid.Column="1" x:Name="numeroNotaFinalEntry"
                                               Keyboard="Numeric"
                                               BackgroundColor="Transparent"
                                               TextColor="#333333" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Gerar Chaves" Clicked="OnGerarChavesClicked" Margin="0,8,0,0" />

            </VerticalStackLayout>
        </Grid>

        <!-- Painel direito: resultado -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" BackgroundColor="#F2F2F2" Padding="20" RowSpacing="8">

            <Label Grid.Row="0" Text="Chaves NFe:" FontAttributes="Bold" FontSize="18" />

            <Editor Grid.Row="1"
                    x:Name="chavesEditor"
                    IsReadOnly="True"
                    BackgroundColor="White"
                    FontFamily="OpenSansRegular"
                    VerticalOptions="Fill" />

        </Grid>

    </Grid>
</ContentPage>
