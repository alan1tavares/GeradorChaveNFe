<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GeradorChaveNFe.MainPage">
    <ScrollView>
        <Grid ColumnDefinitions="280,*" RowDefinitions="*"
              Padding="16" ColumnSpacing="16">

            <!-- Painel esquerdo: formulário -->
            <VerticalStackLayout Grid.Column="0" Spacing="6">

                <Label Text="UF:" />
                <Picker x:Name="uFPicker" Title="Selecione o estado"
                        ItemDisplayBinding="{Binding Nome}" />

                <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <Label Grid.Column="0" Grid.Row="0" Text="Mês:" />
                    <Entry Grid.Column="0" Grid.Row="1" x:Name="mesEntry" Keyboard="Numeric" />
                    <Label Grid.Column="2" Grid.Row="0" Text="Ano:" />
                    <Entry Grid.Column="2" Grid.Row="1" x:Name="anoEntry" Keyboard="Numeric" />
                </Grid>

                <Label Text="CNPJ:" />
                <Entry x:Name="cnpjEntry" Keyboard="Numeric" />

                <Label Text="Série:" />
                <Entry x:Name="serieEntry" Keyboard="Numeric" />

                <Border Stroke="Gray" StrokeThickness="1" Padding="8" Margin="0,4,0,4">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Número da Nota" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto" RowSpacing="4">
                            <Label Grid.Column="0" Grid.Row="0" Text="Inicial:" />
                            <Entry Grid.Column="0" Grid.Row="1" x:Name="numeroNotaInicialEntry" Keyboard="Numeric" />
                            <Label Grid.Column="2" Grid.Row="0" Text="Final:" />
                            <Entry Grid.Column="2" Grid.Row="1" x:Name="numeroNotaFinalEntry" Keyboard="Numeric" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Gerar Chaves" Clicked="OnGerarChavesClicked" />

            </VerticalStackLayout>

            <!-- Painel direito: resultado -->
            <VerticalStackLayout Grid.Column="1" Spacing="6">
                <Label Text="Chaves NFe:" />
                <Editor x:Name="chavesEditor"
                        IsReadOnly="True"
                        BackgroundColor="#EEEEEE"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="240"
                        FontFamily="OpenSansRegular" />
            </VerticalStackLayout>

        </Grid>
    </ScrollView>
</ContentPage>
